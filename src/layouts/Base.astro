---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const site = 'Zach Christensen';
const { title, description = 'Projects and writing by Zach Christensen.' } = Astro.props;
const pageTitle = title ? `${title} · ${site}` : site;
const isHome = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <link rel="alternate" type="application/rss+xml" title={site} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400..700&family=Fragment+Mono&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..600;1,8..60,400&display=swap"
    />
    <ClientRouter />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="shell">
      <header class="masthead">
        {isHome ? (
          <p class="name">Zach Christensen</p>
        ) : (
          <a class="name back" href="/">
            <svg class="icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
            Zach Christensen
          </a>
        )}
      </header>
      <main id="main">
        <slot />
      </main>
      <footer class="foot">
        <a href="https://github.com/zchristensen-nu">GitHub</a>
        <a href="/rss.xml">RSS</a>
        <a href="/tiles/">Style tiles</a>
      </footer>
    </div>
  </body>
</html>

<style>
  .masthead { margin-bottom: 2.75rem; }
  .name {
    margin: 0;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin-left: -0.15rem;
    text-decoration: none;
    color: var(--muted);
  }
  .back:hover { color: var(--ink); }
  .back .icon { transition: transform 200ms var(--ease-out); }
  .back:hover .icon { transform: translateX(-2px); }
  .foot {
    display: flex;
    gap: 1.25rem;
    margin-top: 5rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.8125rem;
    color: var(--muted);
  }
  .foot a { text-decoration: none; }
  .foot a:hover { color: var(--ink); }
</style>
