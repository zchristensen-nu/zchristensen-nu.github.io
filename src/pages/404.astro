---
import Base from '../layouts/Base.astro';
---

<Base title="Not found">
  <h1>Nothing at this address</h1>
  <p>The page may have moved. <a href="/">Back to the library</a>.</p>
</Base>

<style>
  h1 { margin: 0 0 0.75rem; font-size: clamp(1.625rem, 4vw, 2rem); font-weight: 600; letter-spacing: -0.03em; }
  p { margin: 0; color: var(--muted); }
</style>
