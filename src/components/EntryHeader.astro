---
interface Props {
  kind: 'project' | 'post';
  id: string;
  title: string;
  description: string;
}

const { kind, id, title, description } = Astro.props;
---

<header class="entry-head">
  <h1 transition:name={`title-${kind}-${id}`}>{title}</h1>
  <p class="lede">{description}</p>
  <div class="meta"><slot /></div>
</header>

<style>
  .entry-head { margin-bottom: 2.75rem; }
  h1 {
    margin: 0;
    width: fit-content;
    font-size: clamp(1.625rem, 4vw, 2rem);
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .lede {
    margin: 0.75rem 0 0;
    max-width: 34rem;
    font-size: 1.0625rem;
    line-height: 1.55;
    color: var(--muted);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 1.1rem;
    margin-top: 1.25rem;
    font-size: 0.8125rem;
    color: var(--faint);
  }
  .meta :global(time),
  .meta :global(.mono) {
    font-family: var(--mono);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }
  .meta :global(a) {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    color: var(--muted);
    text-decoration: none;
  }
  .meta :global(a:hover) { color: var(--accent); }
</style>
